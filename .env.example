DATABASE_URL=postgres://pos:pos@localhost:5432/pos
TEST_DATABASE_URL=postgres://pos:pos@localhost:5433/pos_test

# Optional: host port for the dev database container (default 5432).
# Set this (and the port in DATABASE_URL) if 5432 is already used on your machine.
# DB_PORT=5432

# Optional in development (see .env.production.example for what they do):
# APP_URL=https://<a tunnel to localhost:3000, for M-Pesa sandbox callbacks>
# SECRETS_KEY=<openssl rand -base64 32>
# CRON_SECRET=dev-cron-secret
# AT_USERNAME=sandbox
# AT_API_KEY=
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM="POS <pos@localhost>"
